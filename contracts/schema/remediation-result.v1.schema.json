{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "remediation-result/v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1
    },
    "finding_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "in_progress",
        "verified",
        "failed",
        "rolled_back",
        "rejected"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "queued",
        "patching",
        "simulating",
        "applying",
        "verifying",
        "done"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "change": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "iam_inline_policy"
            },
            "role_name": {
              "type": "string"
            },
            "policy_name": {
              "type": "string"
            },
            "before": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "after": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "summary": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "role_name",
            "policy_name",
            "before",
            "after",
            "summary"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "check_id": {
            "type": "string",
            "minLength": 1
          },
          "phase": {
            "type": "string",
            "enum": [
              "baseline",
              "simulate",
              "live",
              "rollback"
            ]
          },
          "attempt": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "expected": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "actual": {
            "type": "string",
            "enum": [
              "allow",
              "deny",
              "error"
            ]
          },
          "passed": {
            "type": "boolean"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "check_id",
          "phase",
          "attempt",
          "expected",
          "actual",
          "passed"
        ]
      }
    },
    "exploit_replay": {
      "type": "object",
      "properties": {
        "before": {
          "type": "string",
          "enum": [
            "success",
            "blocked",
            "not_run"
          ]
        },
        "after": {
          "type": "string",
          "enum": [
            "success",
            "blocked",
            "not_run"
          ]
        }
      },
      "required": [
        "before",
        "after"
      ]
    },
    "rationale": {
      "type": "string"
    },
    "pr_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "finished_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "schema_version",
    "job_id",
    "finding_id",
    "status",
    "stage",
    "attempts",
    "change",
    "checks",
    "exploit_replay",
    "rationale",
    "pr_url",
    "error",
    "started_at",
    "finished_at"
  ]
}
